---
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<svg class={className} viewBox="0 0 32 32" aria-hidden="true">
  <rect x="2" y="2" width="28" height="28" rx="6" fill="var(--color-primary)"></rect>
  <rect x="7" y="7" width="18" height="18" rx="2" fill="none" stroke="var(--color-primary-content)" stroke-width="2"></rect>
  <path d="M16 7v18M7 16h9" stroke="var(--color-primary-content)" stroke-width="2"></path>
</svg>
