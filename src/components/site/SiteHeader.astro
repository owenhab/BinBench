---
import MobileNav from './MobileNav';
import Logo from './Logo.astro';
import { NAV_LINKS } from './nav';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="sticky top-0 z-40 border-b border-base-300 bg-base-100/90 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-6 px-4 py-3 sm:px-6">
    <a href="/" class="flex items-center gap-2.5" aria-label="Bin Bench home">
      <Logo class="size-8" />
      <span class="text-lg font-bold tracking-tight">Bin <span class="text-primary">Bench</span></span>
    </a>
    <nav aria-label="Main" class="hidden items-center gap-1 md:flex">
      {
        NAV_LINKS.map((l) => (
          <a
            href={l.href}
            aria-current={path === l.href ? 'page' : undefined}
            class:list={[
              'rounded-field px-3 py-2 text-sm font-medium transition-colors hover:bg-base-200',
              path === l.href ? 'text-primary' : 'text-base-content/75',
            ]}
          >
            {l.label}
          </a>
        ))
      }
      <a href="/app" class="btn btn-primary btn-sm ml-3">Open the designer</a>
    </nav>
    <MobileNav client:media="(max-width: 767px)" links={NAV_LINKS} current={path} />
  </div>
</header>
