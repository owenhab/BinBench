---
import Logo from './Logo.astro';
import { NAV_LINKS } from './nav';
const year = new Date().getFullYear();
---

<footer class="border-t border-base-300 bg-base-200">
  <div class="mx-auto flex max-w-6xl flex-col gap-6 px-4 py-10 sm:flex-row sm:items-start sm:justify-between sm:px-6">
    <div class="max-w-sm">
      <a href="/" class="flex items-center gap-2.5">
        <Logo class="size-7" />
        <span class="font-bold">Bin <span class="text-primary">Bench</span></span>
      </a>
      <p class="mt-3 text-sm text-base-content/70">
        Design custom drawer organizers in your browser and print them on your own 3D printer.
      </p>
    </div>
    <nav aria-label="Footer" class="flex flex-wrap gap-x-6 gap-y-2 text-sm">
      {NAV_LINKS.map((l) => <a href={l.href} class="link-hover text-base-content/75">{l.label}</a>)}
      <a href="/app" class="link-hover font-medium text-primary">Open the designer</a>
    </nav>
  </div>
  <div class="border-t border-base-300 py-4 text-center text-xs text-base-content/60">© {year} Bin Bench</div>
</footer>
