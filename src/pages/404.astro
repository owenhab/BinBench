---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="That page doesn’t exist.">
  <section class="mx-auto max-w-xl px-4 py-24 text-center sm:px-6">
    <p class="font-mono text-sm text-primary">404</p>
    <h1 class="mt-2 text-4xl font-extrabold tracking-tight">This drawer is empty</h1>
    <p class="mt-4 text-base-content/70">We couldn’t find that page.</p>
    <div class="mt-8 flex justify-center gap-3">
      <a href="/" class="btn btn-ghost">Go home</a>
      <a href="/app" class="btn btn-primary">Open the designer</a>
    </div>
  </section>
</BaseLayout>
